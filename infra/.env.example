# Copia a infra/.env en el VPS y rellena. Este fichero NO se versiona (ver .gitignore).
# Genera cada secreto con: openssl rand -base64 48

ACADEMY_DOMAIN=academy.inkoova.com
ACME_EMAIL=TODO@inkoova.com
GITHUB_REPOSITORY=inkoova/inkoova-academy
IMAGE_TAG=latest

# ── base de datos ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── secretos de la aplicación ────────────────────────────────────────────────
# Rotar CONTENT_TOKEN_KEY invalida los tokens de contenido vivos (duran 60 s, así que
# el impacto es nulo). Rotar JWT_SIGNING_KEY cierra todas las sesiones.
CONTENT_TOKEN_KEY=
JWT_SIGNING_KEY=
# Rotar esto invalida la verificación de TODOS los certificados ya emitidos. No se rota.
CERTIFICATE_SIGNING_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# ── email (Resend o Brevo, free tier) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hola@inkoova.com

# ── facturación fiscal (T-14) ────────────────────────────────────────────────
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_TAX_ID=
INVOICE_ISSUER_ADDRESS=
# Solo a true cuando el adaptador Verifactu esté conectado; si no, la API rechaza el pago
# a propósito antes que emitir una factura que nunca se declaró.
INVOICE_SUBMIT_TO_AEAT=false

# ── Discord (T-12, opcional) ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── observabilidad (Grafana Cloud free tier, opcional) ───────────────────────
OTEL_ENDPOINT=
OTEL_HEADERS=

# ── backups (Backblaze B2, 10 GB gratis) ─────────────────────────────────────
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
