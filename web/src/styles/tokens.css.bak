/*
 * Design tokens de Inkoova. Copiados de la app corporativa (ADR-002): si divergen, la
 * fuente de verdad es la web corporativa y aquí se actualizan a mano.
 */

:root {
  /* Marca */
  --ink-blue: #1e3a8a;
  --ink-blue-600: #1d4ed8;
  --ink-blue-050: #eff4ff;
  --ink-magenta: #db2777;
  --ink-magenta-050: #fdf2f8;
  --ink-teal: #0891b2;

  /* Neutros */
  --ink-900: #0f172a;
  --ink-700: #334155;
  --ink-500: #64748b;
  --ink-300: #cbd5e1;
  --ink-200: #e2e8f0;
  --ink-100: #f1f5f9;
  --ink-050: #f8fafc;
  --ink-000: #ffffff;

  /* Estado */
  --ink-success: #16a34a;
  --ink-warn: #f59e0b;
  --ink-error: #dc2626;

  /* Superficies */
  --surface: var(--ink-000);
  --surface-muted: var(--ink-050);
  --surface-inverse: var(--ink-900);
  --border: var(--ink-200);
  --text: var(--ink-900);
  --text-muted: var(--ink-500);

  /* Tipografía */
  --font-sans: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

  /* Escala tipográfica: 1.25 desde 16 px, redondeada a valores legibles. */
  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.375rem;
  --text-2xl: 1.75rem;
  --text-3xl: 2.25rem;
  --text-4xl: 3rem;

  /* Espaciado en múltiplos de 4 px */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-24: 6rem;

  --radius-sm: 6px;
  --radius: 10px;
  --radius-lg: 16px;
  --radius-full: 999px;

  --shadow-sm: 0 1px 2px rgb(15 23 42 / 0.06);
  --shadow: 0 4px 16px rgb(15 23 42 / 0.08);
  --shadow-lg: 0 12px 40px rgb(15 23 42 / 0.12);

  --container: 1140px;
  --header-height: 64px;

  /*
   * Anillo de marca. Se usa como borde "encendido" en tarjetas activas y campos con foco,
   * donde un borde de 1 px cambiando de color se nota poco y engordarlo mueve el layout.
   */
  --ring: 0 0 0 3px rgb(30 58 138 / 0.14);
  --ring-accent: 0 0 0 3px rgb(219 39 119 / 0.16);

  /*
   * Retícula de fondo. Es la única licencia "tecnológica" del sistema y va muy diluida: a
   * este contraste ordena el espacio sin competir con el texto que tiene encima.
   */
  --grid-line: rgb(30 58 138 / 0.06);
  --grid-size: 32px;

  /* Curva compartida por todo lo que se mueve, para que nada vaya a su aire. */
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
}

/*
 * El contenido importado trae su propio theme switcher y su propio oscuro. La plataforma
 * respeta la preferencia del sistema para su chrome, sin imponer nada al iframe.
 */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --surface: #0b1220;
    --surface-muted: #111c2f;
    --surface-inverse: #f8fafc;
    --border: #1e293b;
    --text: #e2e8f0;
    --text-muted: #94a3b8;
    --ink-050: #111c2f;
    --ink-100: #16233a;
    --ink-000: #0b1220;
    --ink-900: #e2e8f0;
    --ink-blue-050: #14213f;
    --ink-magenta-050: #2a1224;

    /* En oscuro la sombra no se ve: lo que separa una tarjeta del fondo es el borde. */
    --shadow-sm: none;
    --shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    --shadow-lg: 0 20px 50px rgb(0 0 0 / 0.45);
    --grid-line: rgb(148 163 184 / 0.07);
    --ring: 0 0 0 3px rgb(96 165 250 / 0.22);
    --ring-accent: 0 0 0 3px rgb(244 114 182 / 0.22);
  }
}

:root[data-theme='dark'] {
  --surface: #0b1220;
  --surface-muted: #111c2f;
  --surface-inverse: #f8fafc;
  --border: #1e293b;
  --text: #e2e8f0;
  --text-muted: #94a3b8;
  --ink-050: #111c2f;
  --ink-100: #16233a;
  --ink-000: #0b1220;
  --ink-900: #e2e8f0;
  --ink-blue-050: #14213f;
  --ink-magenta-050: #2a1224;
}
